<!--
  Lab track on the 10 x 4 grid of 0.5 m floor tiles: plan and all numbers in config/arena_lab.json
  (top view with tile numbers: python experiments/plot_track.py -> results/track_arena_lab.png).

  World frame: origin at the outer corner of the bottom-left tile, x along the 10 tiles (5.0 m), y along
  the 4 tiles (2.0 m), z up. The dark lines on the floor are the tile edges, every 0.5 m from the origin.
  Free floor (the outline): the 5.0 x 1.5 m band y 0.5-2.0 plus the 2.0 x 0.5 m pocket x 0-2, y 0-0.5
  where the robot docks. The tiles x 2.0-4.0, y 0-0.5 hold furniture; x 4.0-5.0, y 0-0.5 is left outside.
  Walls: the 57 x 20 cm panels, 0.02 m thick, inner face on the outline (27 panels).
  Route: start (4.5, 1.25) facing -x, leg 1 along y = 1.25 past the box, LEFT turn at the corner
  (0.5, 1.25), leg 2 along -y to the pre-dock point (0.5, 0.7) and the dock marker at (0.5, 0).

  Three ArUco markers (DICT_4X4_50, 0.10 m on 0.1333 m sheets, centre 0.10 m up), the EKF's map:
    id 1  on the left end panel (x = 0) at y = 1.75, facing +x: seen along leg 1, above the box
    id 2  on the left end panel (x = 0) at y = 0.75, facing +x: seen along leg 1, below the box
    id 0  dock, on the pocket's bottom panel (y = 0) at x = 0.5, facing +y
  Marker sheets and tile lines are visual only (group 2): the LiDAR does not see them.

  The printed obstacle box (0.20 x 0.20 x 0.20 m) is moved by src/robot/task.py ("obstacle"; a
  second box "obstacle2" is parked for scenario code that expects it).
-->
<mujoco model="track_a_lab">
  <include file="turtlebot3_waffle_pi.xml"/>

  <statistic center="2.5 1.0 0.3" extent="4"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <global azimuth="270" elevation="-60"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <material name="floor" rgba="0.62 0.62 0.6 1"/>
    <material name="tile_line" rgba="0.25 0.25 0.25 1"/>
    <material name="panel" rgba="0.92 0.92 0.9 1"/>
    <material name="furniture" rgba="0.2 0.2 0.22 1"/>
    <material name="obstacle" rgba="0.85 0.45 0.2 1"/>
    <material name="dock_plate" rgba="0.15 0.6 0.35 1"/>
    <!-- generated by experiments/make_textures.py: 1024 px, 768 px marker + one-cell quiet zone -->
    <texture name="aruco0_tex" type="2d" file="assets/aruco_4x4_50_id0.png"/>
    <texture name="aruco1_tex" type="2d" file="assets/aruco_4x4_50_id1.png"/>
    <texture name="aruco2_tex" type="2d" file="assets/aruco_4x4_50_id2.png"/>
    <material name="aruco0" texture="aruco0_tex" specular="0" shininess="0"/>
    <material name="aruco1" texture="aruco1_tex" specular="0" shininess="0"/>
    <material name="aruco2" texture="aruco2_tex" specular="0" shininess="0"/>
  </asset>

  <worldbody>
    <light pos="2.5 1.0 3" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="floor"/>

    <!-- Tile edges every 0.5 m (visual only) -->
    <geom name="tile_x00" type="box" size="0.004 1.0 0.0005" pos="0 1.0 0.0005" material="tile_line"
          contype="0" conaffinity="0" group="2"/>
    <geom name="tile_x01" type="box" size="0.004 1.0 0.0005" pos="0.5 1.0 0.0005" material="tile_line"
          contype="0" conaffinity="0" group="2"/>
    <geom name="tile_x02" type="box" size="0.004 1.0 0.0005" pos="1 1.0 0.0005" material="tile_line"
          contype="0" conaffinity="0" group="2"/>
    <geom name="tile_x03" type="box" size="0.004 1.0 0.0005" pos="1.5 1.0 0.0005" material="tile_line"
          contype="0" conaffinity="0" group="2"/>
    <geom name="tile_x04" type="box" size="0.004 1.0 0.0005" pos="2 1.0 0.0005" material="tile_line"
          contype="0" conaffinity="0" group="2"/>
    <geom name="tile_x05" type="box" size="0.004 1.0 0.0005" pos="2.5 1.0 0.0005" material="tile_line"
          contype="0" conaffinity="0" group="2"/>
    <geom name="tile_x06" type="box" size="0.004 1.0 0.0005" pos="3 1.0 0.0005" material="tile_line"
          contype="0" conaffinity="0" group="2"/>
    <geom name="tile_x07" type="box" size="0.004 1.0 0.0005" pos="3.5 1.0 0.0005" material="tile_line"
          contype="0" conaffinity="0" group="2"/>
    <geom name="tile_x08" type="box" size="0.004 1.0 0.0005" pos="4 1.0 0.0005" material="tile_line"
          contype="0" conaffinity="0" group="2"/>
    <geom name="tile_x09" type="box" size="0.004 1.0 0.0005" pos="4.5 1.0 0.0005" material="tile_line"
          contype="0" conaffinity="0" group="2"/>
    <geom name="tile_x10" type="box" size="0.004 1.0 0.0005" pos="5 1.0 0.0005" material="tile_line"
          contype="0" conaffinity="0" group="2"/>
    <geom name="tile_y0" type="box" size="2.5 0.004 0.0005" pos="2.5 0 0.0005" material="tile_line"
          contype="0" conaffinity="0" group="2"/>
    <geom name="tile_y1" type="box" size="2.5 0.004 0.0005" pos="2.5 0.5 0.0005" material="tile_line"
          contype="0" conaffinity="0" group="2"/>
    <geom name="tile_y2" type="box" size="2.5 0.004 0.0005" pos="2.5 1 0.0005" material="tile_line"
          contype="0" conaffinity="0" group="2"/>
    <geom name="tile_y3" type="box" size="2.5 0.004 0.0005" pos="2.5 1.5 0.0005" material="tile_line"
          contype="0" conaffinity="0" group="2"/>
    <geom name="tile_y4" type="box" size="2.5 0.004 0.0005" pos="2.5 2 0.0005" material="tile_line"
          contype="0" conaffinity="0" group="2"/>

    <!-- Panels, 0.20 m high, on the outer side of each outline edge -->
    <geom name="panel_pocket_bottom" type="box" size="1.02 0.01 0.1" pos="1.0 -0.01 0.1" material="panel"/>
    <geom name="panel_pocket_right" type="box" size="0.01 0.26 0.1" pos="2.01 0.25 0.1" material="panel"/>
    <geom name="panel_bottom" type="box" size="1.52 0.01 0.1" pos="3.5 0.49 0.1" material="panel"/>
    <geom name="panel_right" type="box" size="0.01 0.77 0.1" pos="5.01 1.25 0.1" material="panel"/>
    <geom name="panel_top" type="box" size="2.52 0.01 0.1" pos="2.5 2.01 0.1" material="panel"/>
    <geom name="panel_left" type="box" size="0.01 1.02 0.1" pos="-0.01 1.0 0.1" material="panel"/>

    <!-- Furniture on the tiles x 2.0-4.0, y 0-0.5, behind the panels -->
    <geom name="furniture" type="box" size="0.98 0.23 0.35" pos="3.01 0.24 0.35" material="furniture"/>

    <!-- Landmarks: the plane frame is the marker frame {M}, normal = z out of the panel -->
    <geom name="aruco_dock" type="plane" size="0.0666667 0.0666667 0.001" pos="0.5 0.001 0.10"
          xyaxes="-1 0 0 0 0 1" material="aruco0" contype="0" conaffinity="0" group="2"/>
    <geom name="aruco_L2" type="plane" size="0.0666667 0.0666667 0.001" pos="0.001 0.75 0.10"
          xyaxes="0 1 0 0 0 1" material="aruco2" contype="0" conaffinity="0" group="2"/>
    <geom name="aruco_L1" type="plane" size="0.0666667 0.0666667 0.001" pos="0.001 1.75 0.10"
          xyaxes="0 1 0 0 0 1" material="aruco1" contype="0" conaffinity="0" group="2"/>
    <geom name="dock_plate" type="box" size="0.2 0.2 0.002" pos="0.5 0.356 0.002" material="dock_plate"
          contype="0" conaffinity="0" group="2"/>

    <!-- Printed obstacle box (0.20 x 0.20 x 0.20 m). Default: parked under the floor = "none". -->
    <geom name="obstacle" type="box" size="0.1 0.1 0.1" pos="2.75 1.25 -1" material="obstacle"/>
    <geom name="obstacle2" type="box" size="0.1 0.1 0.1" pos="1.5 1.25 -1" material="obstacle"/>
  </worldbody>
</mujoco>

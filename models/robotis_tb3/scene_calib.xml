<!--
  Camera calibration scene: the robot and a 9 x 6 checkerboard (25 mm squares, the W3 board) on a mocap
  body, so experiments/calibrate_camera.py can hold the board at many poses in front of the camera,
  the way you would wave a printed board in front of the real Pi camera.
  The floor is plain grey so nothing else in view looks like a checkerboard.
-->
<mujoco model="camera_calibration">
  <include file="turtlebot3_waffle_pi.xml"/>

  <statistic center="0.4 0 0.1" extent="1"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.4 0.4 0.4" specular="0 0 0"/>
  </visual>

  <asset>
    <!-- generated by experiments/make_textures.py: 60 px squares + 60 px margin on a 0.30 x 0.225 m plane -->
    <texture name="board_tex" type="2d" file="assets/checkerboard_9x6_25mm.png"/>
    <material name="board" texture="board_tex" specular="0" shininess="0"/>
  </asset>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" size="0 0 0.05" type="plane" rgba="0.5 0.5 0.5 1"/>
    <!-- plane +z faces the robot; the calibration script moves this body -->
    <body name="calib_board" mocap="true" pos="0.5 0 0.103" xyaxes="0 -1 0 0 0 1">
      <geom type="plane" size="0.15 0.1125 0.001" material="board" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
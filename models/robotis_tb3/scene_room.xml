<!--
  Test room for Track A: 4 m x 3 m, walls 0.4 m high, three obstacles 0.3 m high, and an ArUco-marked
  docking station against the east wall.
  Everything the LiDAR must see has to be taller than its scan plane (0.132 m).
  World frame: origin at the room centre, x towards the east wall, z up. The robot starts at the origin.
  Kept in this folder because MuJoCo resolves included files and meshdir relative to the main file.

  PLACEHOLDERS until the lab values are known: room size, obstacle layout, dock pose and size,
  marker dictionary / id / size (DICT_4X4_50, id 0, 0.10 m; see src/perception/aruco.py).
-->
<mujoco model="track_a_room">
  <include file="turtlebot3_waffle_pi.xml"/>

  <statistic center="0 0 0.3" extent="3"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <global azimuth="120" elevation="-45"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"/>
    <material name="wall" rgba="0.82 0.82 0.78 1"/>
    <material name="obstacle" rgba="0.85 0.45 0.2 1"/>
    <material name="dock" rgba="0.25 0.25 0.3 1"/>
    <!-- generated by experiments/make_textures.py (W3 marker_image): 1024 x 1024 px, a 768 px marker
         (6 cells of 128 px) inside a one-cell white quiet zone -->
    <texture name="aruco_tex" type="2d" file="assets/aruco_4x4_50_id0.png"/>
    <material name="aruco" texture="aruco_tex" specular="0" shininess="0"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <geom name="wall_east"  type="box" size="0.025 1.525 0.2" pos="2 0 0.2"    material="wall"/>
    <geom name="wall_west"  type="box" size="0.025 1.525 0.2" pos="-2 0 0.2"   material="wall"/>
    <geom name="wall_north" type="box" size="2.025 0.025 0.2" pos="0 1.5 0.2"  material="wall"/>
    <geom name="wall_south" type="box" size="2.025 0.025 0.2" pos="0 -1.5 0.2" material="wall"/>

    <geom name="obs_box1" type="box"      size="0.15 0.15 0.15" pos="-0.9 -0.6 0.15" material="obstacle"/>
    <geom name="obs_cyl"  type="cylinder" size="0.12 0.15"      pos="0.2 0.8 0.15"   material="obstacle"/>
    <geom name="obs_box2" type="box"      size="0.10 0.25 0.15" pos="1.0 -0.5 0.15"  material="obstacle"/>

    <!-- Docking station, marker facing -x into the room. The 0.1333 m sheet carries a 0.10 m marker
         (768/1024 of the sheet) centred 0.12 m above the floor. The sheet is visual only (group 2): the camera
         sees it, the LiDAR ignores it and hits the dock box 1 mm behind. Its plane frame is the marker frame
         {M}: x right and y up as the robot sees it, z out of the marker. -->
    <body name="dock" pos="1.9 0 0">
      <geom name="dock_body" type="box" size="0.05 0.15 0.125" pos="0 0 0.125" material="dock"/>
      <geom name="aruco_marker" type="plane" size="0.0666667 0.0666667 0.001" pos="-0.051 0 0.12"
            xyaxes="0 -1 0 0 0 1" material="aruco" contype="0" conaffinity="0" group="2"/>
    </body>
  </worldbody>
</mujoco>
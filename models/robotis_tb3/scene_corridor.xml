<!--
  L-shaped corridor for the Track A demo: waypoints along the corridor, LiDAR avoidance of one movable
  box, and ArUco docking. Top-view plan and all numbers: config/corridor.json.

  World frame: x along the first leg (east), y along the second leg (north), z up. The robot starts at
  (0.5, 0, 0 deg), set by the script from config/corridor.json.
  Leg 1: 1.0 m wide, 4.2 m long. Corner: 1.2 x 1.2 m. Obstacle section: 1.5 m wide.
  Dock area: 2.0 x 2.0 m with a 1.9 m straight approach. Walls 0.35 m high (LiDAR plane 0.132 m).
  Walls: a 0.05 m thick box on the outer side of each edge of the outline in config/corridor.json.

  Three fixed ArUco markers (DICT_4X4_50, 0.10 m, centre 0.12 m above the floor), the EKF's map:
    id 1  L1    on the end wall of leg 1, facing -x (seen along leg 1)
    id 2  L2    on the back wall of the dock area, left of the dock, facing -y
    id 0  dock  on the charging station, facing -y
  Marker sheets are visual only (group 2): the camera sees them, the LiDAR hits the wall 1 mm behind.

  The obstacle box is moved between trials by src/robot/corridor.py (configs none / left / right / centre).
-->
<mujoco model="track_a_corridor">
  <include file="turtlebot3_waffle_pi.xml"/>

  <statistic center="2.3 2.1 0.3" extent="5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <global azimuth="225" elevation="-55"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"/>
    <material name="wall" rgba="0.82 0.82 0.78 1"/>
    <material name="obstacle" rgba="0.85 0.45 0.2 1"/>
    <material name="dock" rgba="0.25 0.25 0.3 1"/>
    <material name="dock_plate" rgba="0.15 0.6 0.35 1"/>
    <!-- generated by experiments/make_textures.py: 1024 px, 768 px marker + one-cell quiet zone -->
    <texture name="aruco0_tex" type="2d" file="assets/aruco_4x4_50_id0.png"/>
    <texture name="aruco1_tex" type="2d" file="assets/aruco_4x4_50_id1.png"/>
    <texture name="aruco2_tex" type="2d" file="assets/aruco_4x4_50_id2.png"/>
    <material name="aruco0" texture="aruco0_tex" specular="0" shininess="0"/>
    <material name="aruco1" texture="aruco1_tex" specular="0" shininess="0"/>
    <material name="aruco2" texture="aruco2_tex" specular="0" shininess="0"/>
  </asset>

  <worldbody>
    <light pos="2.3 2.1 3" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <geom name="wall_00" type="box" size="2.15 0.025 0.175" pos="2.1 -0.525 0.175" material="wall"/>
    <geom name="wall_01" type="box" size="0.025 0.625 0.175" pos="4.225 0.075 0.175" material="wall"/>
    <geom name="wall_02" type="box" size="0.1 0.025 0.175" pos="4.3 0.675 0.175" material="wall"/>
    <geom name="wall_03" type="box" size="0.025 1.025 0.175" pos="4.375 1.675 0.175" material="wall"/>
    <geom name="wall_04" type="box" size="0.15 0.025 0.175" pos="4.5 2.675 0.175" material="wall"/>
    <geom name="wall_05" type="box" size="0.025 1.05 0.175" pos="4.625 3.7 0.175" material="wall"/>
    <geom name="wall_06" type="box" size="1.05 0.025 0.175" pos="3.6 4.725 0.175" material="wall"/>
    <geom name="wall_07" type="box" size="0.025 1.05 0.175" pos="2.575 3.7 0.175" material="wall"/>
    <geom name="wall_08" type="box" size="0.15 0.025 0.175" pos="2.7 2.675 0.175" material="wall"/>
    <geom name="wall_09" type="box" size="0.025 1.025 0.175" pos="2.825 1.675 0.175" material="wall"/>
    <geom name="wall_10" type="box" size="0.1 0.025 0.175" pos="2.9 0.675 0.175" material="wall"/>
    <geom name="wall_11" type="box" size="0.025 0.1 0.175" pos="2.975 0.6 0.175" material="wall"/>
    <geom name="wall_12" type="box" size="1.525 0.025 0.175" pos="1.475 0.525 0.175" material="wall"/>
    <geom name="wall_13" type="box" size="0.025 0.55 0.175" pos="-0.025 0 0.175" material="wall"/>

    <!-- Landmarks: 0.1333 m sheets carrying 0.10 m markers; the plane frame is the marker frame {M} -->
    <geom name="aruco_L1" type="plane" size="0.0666667 0.0666667 0.001" pos="4.199 0 0.12"
          xyaxes="0 -1 0 0 0 1" material="aruco1" contype="0" conaffinity="0" group="2"/>
    <geom name="aruco_L2" type="plane" size="0.0666667 0.0666667 0.001" pos="2.95 4.699 0.12"
          xyaxes="1 0 0 0 0 1" material="aruco2" contype="0" conaffinity="0" group="2"/>

    <!-- Charging station: a 0.3 m wide box against the back wall, a green plate on the floor in front -->
    <body name="dock" pos="3.6 4.65 0">
      <geom name="dock_body" type="box" size="0.15 0.05 0.125" pos="0 0 0.125" material="dock"/>
      <geom name="aruco_marker" type="plane" size="0.0666667 0.0666667 0.001" pos="0 -0.051 0.12"
            xyaxes="1 0 0 0 0 1" material="aruco0" contype="0" conaffinity="0" group="2"/>
      <geom name="dock_plate" type="box" size="0.2 0.2 0.002" pos="0 -0.3 0.002" material="dock_plate"
            contype="0" conaffinity="0" group="2"/>
    </body>

    <!-- Movable obstacle (0.3 x 0.3 x 0.25 m). Default: parked under the floor = config "none". -->
    <geom name="obstacle" type="box" size="0.15 0.15 0.125" pos="3.6 1.7 -1" material="obstacle"/>
  </worldbody>
</mujoco>